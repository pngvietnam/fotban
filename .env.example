# Copy to .env. Use the local Compose URL documented in README for development.
# Keep actual credentials in ignored .env files or your host's secret manager.
DATABASE_URL=
SPORTS_API_KEY=
# Primary structured match provider (free tier); server-only.
FOOTBALL_DATA_API_KEY=
# Free Basic plan (100 requests/day) at https://highlightly.net: match events, lineups and statistics.
HIGHLIGHTLY_API_KEY=
# Reserved for optional future adapters; free-first news ingestion needs no API key.
NEWS_API_KEY=
# Server-only Wikimedia identification: AppName/version (contact: your real email or public project URL).
WIKIMEDIA_USER_AGENT=
# Optional server-only YouTube Data API v3 key; blank skips sync, stored verified links still work.
YOUTUBE_API_KEY=
OPENAI_API_KEY=
# Free-first article processing. No paid provider or key is required.
AI_PROVIDER=fallback
# Vietnamese RSS sources are configured through the reviewed NewsSource registry,
# not by API keys or an environment permission bypass. GDELT discovery needs no key.
# Optional vendor-neutral HTTPS gateway implementing docs/AI_PROCESSING.md.
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
# Optional Google OAuth. Blank leaves authentication disabled; public reading still works.
# Generate a random secret of at least 32 characters locally. Never use a shared example secret.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Admin uses these same sessions plus the database ADMIN role. No email-domain grant.
# Bootstrap the first existing user with admin:bootstrap; never add default admin credentials.
# Scheduler ticks are opt-in. Manual execution does not require enabling ticks.
APP_TIMEZONE=Asia/Ho_Chi_Minh
MORNING_BRIEF_HOUR=8
SCHEDULER_ENABLED=false
# Explicit opt-in for safe reference seed; never enable in production.
ALLOW_DEV_SEED=
