{
  "name": "football-morning-brief",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait --wait-timeout 60 postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs --follow postgres",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "provider:sync": "tsx --env-file-if-exists=.env scripts/sync-matches.ts",
    "news:sync": "tsx --env-file-if-exists=.env scripts/sync-news.ts",
    "news:grant": "tsx --env-file-if-exists=.env scripts/grant-news-source.ts",
    "news:worker": "tsx --env-file-if-exists=.env scripts/news-worker.ts",
    "players:images": "tsx --env-file-if-exists=.env scripts/player-images.ts",
    "news:tick": "tsx --env-file-if-exists=.env scripts/sync-news.ts vietnamese",
    "news:cards": "tsx --env-file-if-exists=.env scripts/feed-cards.ts",
    "news:preview-vietnamese": "tsx --env-file-if-exists=.env scripts/preview-vietnamese-news.ts",
    "news:diagnose": "tsx --env-file-if-exists=.env scripts/diagnose-news.ts",
    "news:coverage": "tsx --env-file-if-exists=.env scripts/check-wikinews-coverage.ts",
    "news:accept-vietnamese": "tsx --env-file-if-exists=.env scripts/accept-vietnamese-news.ts",
    "news:discover": "tsx --env-file-if-exists=.env scripts/discover-news.ts",
    "ai:process": "tsx --env-file-if-exists=.env scripts/process-articles.ts",
    "reliability:assess": "tsx --env-file-if-exists=.env scripts/assess-reliability.ts",
    "news:cluster": "tsx --env-file-if-exists=.env scripts/cluster-news.ts",
    "transfers:sync": "tsx --env-file-if-exists=.env scripts/sync-transfers.ts",
    "video:sync": "tsx --env-file-if-exists=.env scripts/sync-videos.ts",
    "brief:generate": "tsx --env-file-if-exists=.env scripts/generate-brief.ts",
    "scheduler:morning": "tsx --env-file-if-exists=.env scripts/run-scheduler.ts",
    "scheduler:tick": "tsx --env-file-if-exists=.env scripts/run-scheduler.ts tick",
    "scheduler:health": "tsx --env-file-if-exists=.env scripts/run-scheduler.ts health",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "tsx --env-file-if-exists=.env scripts/check-db.ts",
    "auth:smoke": "tsx --env-file-if-exists=.env scripts/validate-auth.ts",
    "auth:cleanup": "tsx --env-file-if-exists=.env scripts/clean-auth.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "admin:bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap-admin.ts",
    "admin:smoke": "tsx --env-file-if-exists=.env scripts/validate-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "1.7.10",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.2",
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "pino": "^10.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "robots-parser": "^3.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
